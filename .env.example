# Скопируйте в .env. Не добавляйте .env и ключи в Git.
# Пути относительно корня проекта; каталог данных создаётся автоматически.
DATA_DIR=./data
HOST=127.0.0.1
PORT=8000

# Один пользователь, один воркер. Ограничение одного исходного файла.
MAX_UPLOAD_GB=4
MAX_CLIPS=5
RETENTION_DAYS=7
FFMPEG_THREADS=2

# local: faster-whisper, CPU int8, модель загружается при первом задании.
# openai: облачная транскрипция whisper-1, нужен OPENAI_API_KEY.
TRANSCRIPTION_PROVIDER=local
WHISPER_MODEL=small

# ollama: локальный семантический анализ; предварительно загрузите модель.
# openai: платный API; heuristic: только базовые эвристики, без понимания контекста.
ANALYSIS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Требуется только для выбранного режима openai. Значение вводите только в .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
